<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>iNKORE.UI.WPF.Modern.Mcp</RootNamespace>

		<!-- Run on .NET 8 or any newer runtime, so machines with only .NET 9+ installed work. -->
		<RollForward>Major</RollForward>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>inkore-wpf-mcp</ToolCommandName>
		<PackageId>iNKORE.UI.WPF.Modern.Mcp</PackageId>
		<Authors>iNKORE Studios</Authors>
		<Description>MCP server that gives AI assistants version-matched knowledge of iNKORE.UI.WPF.Modern controls, theme resources, docs and samples.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- Lockstep versioning: the tool version is the library version from AssemblyInfoCommon.cs. -->
	<PropertyGroup>
		<_LibraryAssemblyInfo>$(MSBuildThisFileDirectory)..\iNKORE.UI.WPF.Modern\Properties\AssemblyInfoCommon.cs</_LibraryAssemblyInfo>
		<_LibraryVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(_LibraryAssemblyInfo))), 'AssemblyVersion\("(\d+\.\d+\.\d+)').Groups[1].Value)</_LibraryVersion>
		<Version>$(_LibraryVersion)</Version>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
	</ItemGroup>

	<!--
		Index generation: build the library and IndexGen, run IndexGen, embed index.json.

		  McpIndexPath          Use a prebuilt index.json instead of generating one.
		  DocsPath              iNKORE-NET/Documentation checkout (default: a sibling "Documentation" folder).
		  RequireDocs           true to fail when DocsPath is missing (release builds).
		  LibraryConfiguration  Configuration of the library build to read (default: Release).
	-->
	<PropertyGroup>
		<LibraryConfiguration Condition="'$(LibraryConfiguration)' == ''">Release</LibraryConfiguration>
		<LibraryTargetFramework>net6.0-windows10.0.18362.0</LibraryTargetFramework>
		<DocsPath Condition="'$(DocsPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\Documentation</DocsPath>
		<RequireDocs Condition="'$(RequireDocs)' == ''">false</RequireDocs>
		<_GeneratedIndexPath>$(MSBuildProjectDirectory)\obj\index\index.json</_GeneratedIndexPath>
		<_ControlsProject>$(MSBuildThisFileDirectory)..\iNKORE.UI.WPF.Modern.Controls\iNKORE.UI.WPF.Modern.Controls.csproj</_ControlsProject>
		<_IndexGenProject>$(MSBuildThisFileDirectory)..\..\tools\iNKORE.UI.WPF.Modern.Mcp.IndexGen\iNKORE.UI.WPF.Modern.Mcp.IndexGen.csproj</_IndexGenProject>
	</PropertyGroup>

	<Target Name="GenerateLibraryIndex" BeforeTargets="BeforeBuild" Condition="'$(McpIndexPath)' == '' and '$(DesignTimeBuild)' != 'true'">
		<!-- Restore only when needed, so a solution build's own restore isn't raced. -->
		<MSBuild Projects="$(_ControlsProject)" Targets="Restore" Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
		         Condition="!Exists('$(MSBuildThisFileDirectory)..\iNKORE.UI.WPF.Modern.Controls\obj\project.assets.json')" />
		<MSBuild Projects="$(_ControlsProject)" Targets="Build" Properties="Configuration=$(LibraryConfiguration);TargetFramework=$(LibraryTargetFramework)" />

		<MSBuild Projects="$(_IndexGenProject)" Targets="Restore" Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
		         Condition="!Exists('$(MSBuildThisFileDirectory)..\..\tools\iNKORE.UI.WPF.Modern.Mcp.IndexGen\obj\project.assets.json')" />
		<MSBuild Projects="$(_IndexGenProject)" Targets="Build" Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" PropertyName="_IndexGenAssembly" />
		</MSBuild>

		<PropertyGroup>
			<_IndexGenDocsArgs Condition="Exists('$(DocsPath)')">--docs &quot;$(DocsPath)&quot;</_IndexGenDocsArgs>
			<_IndexGenDocsArgs Condition="'$(RequireDocs)' == 'true'">--docs &quot;$(DocsPath)&quot; --require-docs</_IndexGenDocsArgs>
		</PropertyGroup>
		<Exec Command="dotnet &quot;$(_IndexGenAssembly)&quot; --repo &quot;$(MSBuildThisFileDirectory)..\..&quot; --configuration $(LibraryConfiguration) --framework $(LibraryTargetFramework) --out &quot;$(_GeneratedIndexPath)&quot; $(_IndexGenDocsArgs)" />

		<PropertyGroup>
			<McpIndexPath>$(_GeneratedIndexPath)</McpIndexPath>
		</PropertyGroup>
	</Target>

	<Target Name="EmbedLibraryIndex" BeforeTargets="BeforeBuild" AfterTargets="GenerateLibraryIndex" Condition="'$(DesignTimeBuild)' != 'true'">
		<Error Condition="!Exists('$(McpIndexPath)')" Text="Library index not found at '$(McpIndexPath)'." />
		<ItemGroup>
			<EmbeddedResource Include="$(McpIndexPath)" LogicalName="iNKORE.UI.WPF.Modern.Mcp.index.json" />
		</ItemGroup>
	</Target>

</Project>
